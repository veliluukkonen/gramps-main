POSTGRES_DB=gramps_db
POSTGRES_USER=gramps_user
POSTGRES_PASSWORD=change_me_to_a_secure_password
DJANGO_SECRET_KEY=change_me_to_a_long_random_string
DJANGO_DEBUG=False
CADDY_DOMAIN=gramps.local

# Public address used in e-mail links (password reset, new-user notice)
BASE_URL=http://gramps.local
# Self-registration on/off
REGISTRATION_DISABLED=true
# SMTP for outgoing e-mail. Leave EMAIL_HOST empty to log mails instead of sending.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=
